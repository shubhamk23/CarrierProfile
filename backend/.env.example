# Application Settings
APP_NAME=Shubham Khanapure Portfolio API
APP_VERSION=1.0.0
DEBUG=False

# CORS - Add your frontend URL here
ALLOWED_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# Database (Supabase PostgreSQL - use the pooler endpoint, port 6543, for serverless)
# Format: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres
DATABASE_URL=postgresql://postgres:your-password-here@db.your-project-ref.supabase.co:6543/postgres

# Database Connection Pool Settings (Optimized for Vercel Serverless + PgBouncer)
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=3600

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=your-inbox@example.com
