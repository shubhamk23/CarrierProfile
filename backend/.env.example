# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Shubham Khanapure Portfolio API
APP_VERSION=1.1.0
DEBUG=False

# ─────────────────────────────────────────────────────────────────────────────
# Security
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-with-openssl

# ─────────────────────────────────────────────────────────────────────────────
# CORS — add every frontend origin (no wildcards in production)
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# ─────────────────────────────────────────────────────────────────────────────
# Database (Supabase Postgres)
# Format: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=True

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────────────────────────
USE_JSON_STORAGE=False

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend) — leave blank to skip email send in local dev
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Knowledge hub
#   * KNOWLEDGE_JWT_SECRET_KEY  — generate with: openssl rand -hex 32
#   * KNOWLEDGE_ADMIN_PASSWORD  — strong random; hashed at first boot
#   * KNOWLEDGE_ENABLE_WATCHER  — local dev only; MUST be False in serverless
#   * KNOWLEDGE_ENABLE_AGENT    — Phase B feature flag
#   * KNOWLEDGE_INDEX_ON_BOOT   — empty-DB bootstrap reindex (idempotent)
# ─────────────────────────────────────────────────────────────────────────────
KNOWLEDGE_CONTENT_DIR=app/content
KNOWLEDGE_JWT_SECRET_KEY=change-me-in-production
KNOWLEDGE_JWT_ALGORITHM=HS256
KNOWLEDGE_JWT_EXPIRE_HOURS=24
KNOWLEDGE_ADMIN_USERNAME=admin
KNOWLEDGE_ADMIN_PASSWORD=change-me-in-production
KNOWLEDGE_ENABLE_WATCHER=False
KNOWLEDGE_ENABLE_AGENT=False
KNOWLEDGE_INDEX_ON_BOOT=True
