# Application Settings
APP_NAME=Shubham Khanapure Portfolio API
APP_VERSION=1.0.0
DEBUG=False

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl

# CORS - Add your frontend URL here
ALLOWED_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:Shubhamk@23@db.wjlirjrjuvimoaydtenj.supabase.co:5432/postgres

# Database Connection Pool Settings (Optimized for Vercel Serverless)
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=3600

# Feature Flags
USE_JSON_STORAGE=False
